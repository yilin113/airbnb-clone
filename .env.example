# MongoDB connection used by Prisma.
DATABASE_URL="mongodb+srv://USERNAME:PASSWORD@HOST/DATABASE"

# NextAuth application URL and session secret.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Optional OAuth providers.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Cloudinary upload widget configuration.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# Browser key restricted to the production domain and the Places API (New) /
# Maps JavaScript API. This value is intentionally public in the browser.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Optional AI-assisted listing copy. Keep the API key server-side only.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-6-astra"

# Reservation pricing (basis points: 600 = 6%).
GUEST_SERVICE_FEE_BPS="600"
HOST_COMMISSION_BPS="600"
GUEST_SERVICE_FEE_CAP_JPY="30000"
